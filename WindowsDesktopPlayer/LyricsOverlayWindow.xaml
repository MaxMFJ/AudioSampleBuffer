<Window x:Class="SoundDesk.LyricsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="960" Height="154" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" ShowActivated="False">
    <Grid x:Name="LyricsRoot" Background="Transparent">
        <StackPanel x:Name="LyricsStack" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
