<Window x:Class="SoundDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Desk" Width="1180" Height="780" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0C101A" Foreground="#F4F5FF">
    <Window.Resources>
        <LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101828" Offset="0" />
            <GradientStop Color="#1C1931" Offset="0.54" />
            <GradientStop Color="#10131F" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource Backdrop}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
        <Canvas x:Name="SpectrumCanvas" IsHitTestVisible="False" ClipToBounds="True" />
        <Grid Margin="28,24,28,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#9B141A28" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="22" Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="2,2,2,22">
                        <TextBlock Text="S O U N D   D E S K" Foreground="#B5BCE0" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="音乐控制台" FontSize="23" FontWeight="SemiBold" Margin="0,13,0,3" />
                        <TextBlock Text="搜索、聆听与塑造你的声音空间" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="2,20,2,0">
                        <Button Content="＋  导入本地音乐" Click="Import_Click" HorizontalContentAlignment="Left" />
                        <Button Content="⌕  搜索在线音乐" Margin="0,8,0,0" Click="OnlineSearch_Click" HorizontalContentAlignment="Left" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="音乐库" Style="{StaticResource SectionLabel}" Margin="4,0,0,8" />
                        <Button Content="♫  所有歌曲" HorizontalContentAlignment="Left" Click="AllSongs_Click" />
                        <Button Content="◷  最近播放" HorizontalContentAlignment="Left" Margin="0,5,0,0" Click="Recent_Click" />
                        <Button Content="♡  我的收藏" HorizontalContentAlignment="Left" Margin="0,5,0,0" Click="Favorites_Click" />
                        <TextBlock Text="桌面体验" Style="{StaticResource SectionLabel}" Margin="4,22,0,8" />
                        <Button x:Name="LyricsButton" Content="▤  桌面歌词" HorizontalContentAlignment="Left" Click="Lyrics_Click" />
                        <TextBlock Text="音频响应效果" Style="{StaticResource SectionLabel}" Margin="4,18,0,7" />
                        <ComboBox x:Name="EffectSelector" SelectedIndex="0" SelectionChanged="EffectSelector_SelectionChanged" Height="34" Background="#202B3E" Foreground="#F4F5FF">
                            <ComboBoxItem Content="极光波纹" />
                            <ComboBoxItem Content="丁达尔光束" />
                            <ComboBoxItem Content="封面点阵" />
                            <ComboBoxItem Content="深空蜂巢" />
                        </ComboBox>
                        <Button Content="☷  平台账号" HorizontalContentAlignment="Left" Margin="0,5,0,0" Click="Accounts_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="#97141927" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="22" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR SOUND SPACE" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="SectionTitle" Text="所有歌曲" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MonitorButton" Content="关闭桌面背景" Margin="0,0,8,0" Click="Monitor_Click" />
                            <Button Content="添加歌曲" Background="#596AE3" BorderBrush="#7C8CFF" Click="Import_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="40" VerticalContentAlignment="Center" ToolTip="搜索本地曲库" TextChanged="Search_TextChanged" />
                        <TextBlock Text="⌕" FontSize="18" Foreground="#8490AA" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Column="1" x:Name="TrackCount" Text="0 首歌曲" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="12,0,12,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                            <TextBlock Text="歌曲" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="艺术家" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="2" Text="时长" Style="{StaticResource SectionLabel}" />
                        </Grid>
                        <ListBox x:Name="TrackList" Grid.Row="1" SelectionChanged="TrackList_SelectionChanged" MouseDoubleClick="TrackList_DoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="切换收藏" Click="Favorite_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Album}" FontSize="10" Foreground="#929BB0" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Artist}" Foreground="#B3B9C9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#929BB0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="♪" FontSize="42" Foreground="#7783AC" HorizontalAlignment="Center" />
                            <TextBlock Text="把音乐放进你的声音空间" FontSize="17" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,12,0,5" />
                            <TextBlock Text="导入本地音频，即可开始播放和探索视觉效果" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" Margin="28,0,28,20" Background="#E0181E2D" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="18" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NowPlayingTitle" Text="尚未播放" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowPlayingArtist" Text="导入本地音乐开始播放" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PreviousButton" Content="|◀" Padding="11,5" Click="Previous_Click" />
                        <Button x:Name="PlayButton" Content="▶" Padding="18,5" Margin="10,0" Background="#596AE3" Click="Play_Click" />
                        <Button Content="▶|" Padding="11,5" Click="Next_Click" />
                        <Button x:Name="RepeatButton" Content="顺序播放" Padding="11,5" Margin="10,0,0,0" Click="Repeat_Click" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                        <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Progress_ValueChanged" PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp" Height="18" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="音量" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.75" Width="112" ValueChanged="Volume_ValueChanged" />
                </StackPanel>
            </Grid>
        </Border>
        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Volume="0.75" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" Visibility="Collapsed" />
    </Grid>
</Window>
