<Window x:Class="SoundDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面音乐" Width="1040" Height="700" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0C101A" Foreground="#F4F5FF">
    <Window.Resources>
        <LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101828" Offset="0" />
            <GradientStop Color="#1C1931" Offset="0.54" />
            <GradientStop Color="#10131F" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Window.Resources>
    <Grid x:Name="RootSurface" Background="{StaticResource Backdrop}">
        <Border x:Name="GlassPanel" Margin="18" Background="#9B141A28" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="28" Padding="28,24,28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="130" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="音乐控制台" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="S O U N D   D E S K" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="搜索、聆听与塑造你的声音空间" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource HeaderAction}" Content="♫  歌曲列表" Click="SongList_Click" />
                        <Button Style="{StaticResource HeaderAction}" Content="▤  歌词管理" Click="LyricsSettings_Click" />
                        <Button Style="{StaticResource HeaderAction}" Content="◉  平台账号" Click="Accounts_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource HeaderAction}" Content="▣  窗口预览" Click="WindowMonitor_Click" />
                        <Button Style="{StaticResource HeaderAction}" Content="☁  平台歌单" Click="PlatformLibrary_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Height="44" Background="#11FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="14">
                            <Grid>
                                <TextBlock Text="⌕" FontSize="17" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,2" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="SearchBox" Margin="36,0,14,0" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14"
                                         VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown" ToolTip="搜索歌曲或歌手" />
                                <TextBlock x:Name="SearchPlaceholder" Text="搜索歌曲或歌手" FontSize="14" Foreground="#7F8AA3" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Content="搜索" Width="72" Height="38" Margin="10,0,0,0" FontWeight="Medium" Click="Search_Click" />
                    </Grid>
                    <TextBlock x:Name="SearchStatus" Text="搜索在线音乐" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,10,0,0" />
                </StackPanel>

                <ListBox x:Name="OnlineResults" Grid.Row="2" Margin="0,0,0,18">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Height" Value="44" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0.32*" MinWidth="100" MaxWidth="180" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Content="下载" Width="72" Height="28" Padding="0" Click="DownloadResult_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="0,0,0,20">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="视觉效果" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="WallpaperRendererStatus" Text="桌面背景已关闭" FontSize="11" Foreground="#7F8AA3" HorizontalAlignment="Right" />
                    </DockPanel>
                    <UniformGrid Rows="1" Columns="4" Margin="0,0,-9,0">
                        <ToggleButton x:Name="TyndallEffect" Style="{StaticResource EffectToggle}" Tag="1" Content="丁达尔光束" Click="Effect_Click" />
                        <ToggleButton x:Name="CoverDotsEffect" Style="{StaticResource EffectToggle}" Tag="2" Content="封面点阵" Click="Effect_Click" />
                        <ToggleButton x:Name="CellularEffect" Style="{StaticResource EffectToggle}" Tag="0" Content="深空蜂巢" Click="Effect_Click" />
                        <ToggleButton x:Name="HexagonEffect" Style="{StaticResource EffectToggle}" Tag="3" Content="六边形（原版）" Click="Effect_Click" />
                    </UniformGrid>
                </StackPanel>

                <DockPanel Grid.Row="4" Margin="0,0,0,20" LastChildFill="True">
                    <Button Style="{StaticResource IconButton}" Content="⏮" ToolTip="上一首" Click="Previous_Click" />
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="▶" ToolTip="播放 / 暂停" Margin="10,0,0,0" Click="Play_Click" />
                    <Button Style="{StaticResource IconButton}" Content="⏭" ToolTip="下一首" Margin="10,0,0,0" Click="Next_Click" />
                    <Button Style="{StaticResource IconButton}" Content="■" ToolTip="停止" Margin="10,0,0,0" Click="Stop_Click" />
                    <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Content="♡" ToolTip="喜欢" Margin="10,0,0,0" Click="FavoriteCurrent_Click" />
                    <Button x:Name="RepeatButton" Content="顺序播放" Height="32" Padding="12,0" FontSize="12" Margin="10,0,0,0" Click="Repeat_Click" />
                    <Button Content="选择本地歌曲" Height="32" Padding="12,0" FontSize="12" Margin="10,0,0,0" Click="OpenLocal_Click" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="音量" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.75" Width="96" VerticalAlignment="Center" ValueChanged="Volume_ValueChanged" />
                    </StackPanel>
                    <TextBlock x:Name="NowPlaying" Text="尚未播放" FontSize="14" FontWeight="Medium" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <StackPanel Grid.Row="5">
                    <TextBlock Text="关闭识别与分离时，使用实时 FFT" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,8">
                        <CheckBox Content="YAMNet 音乐识别" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="需要 ONNX 版 YAMNet 模型，Windows 版尚未接入" />
                        <CheckBox Content="HTDemucs 乐器分离" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="需要 ONNX 版 HTDemucs 模型，Windows 版尚未接入" />
                        <CheckBox x:Name="WallpaperToggle" Content="显示动态桌面背景" IsChecked="True" Click="WallpaperToggle_Click" />
                    </UniformGrid>
                    <UniformGrid Rows="1" Columns="3">
                        <CheckBox x:Name="GuitarSurgeToggle" Content="吉他高潮全屏扫光（鼓点同步）" Click="GuitarSurge_Click" />
                        <CheckBox x:Name="CenterRecordToggle" Content="其他特效显示圆形唱片" Click="CenterRecord_Click" />
                        <Button Content="氛围光 AI 设置…" HorizontalAlignment="Left" Padding="12,5" Click="MoodSettings_Click" />
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Volume="0.75" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" Visibility="Collapsed" />
    </Grid>
</Window>
